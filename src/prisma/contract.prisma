// use prisma-8
model Department {
  id        String @id @default(uuid())
  dept_name String @unique
}

model User {
  id        String                     @id @default(uuid())
  email     String                     @unique
  password  String
  gender    String
  role      String
  status    Boolean                    @default(true)
  isDelete  Boolean                    @default(false)
  createdAt temporal.createdAtString()
  updatedAt temporal.updatedAtString()
}

model Admin {
  id           String                     @id @default(uuid())
  Name         String
  userId       String                     @unique
  user         User                       @relation(fields: [userId], references: [id])
  phoneNumber  String
  profileImage String
  createdAt    temporal.createdAtString()
  updatedAt    temporal.updatedAtString()
}

model Patients {
  id            String                     @id @default(uuid())
  Name          String
  dateOfBirth   TimestamptzString
  userId        String                     @unique
  user          User                       @relation(fields: [userId], references: [id])
  contactNumber String
  address       String
  profilePhoto  String
  createdAt     temporal.createdAtString()
  updatedAt     temporal.updatedAtString()
}

model Doctors {
  id                    String                     @id @default(uuid())
  Name                  String
  description_degree    String
  description_treatment String
  userId                String                     @unique
  user                  User                       @relation(fields: [userId], references: [id])
  profileImage          String
  contactNumber         String
  regastationNumber     String
  address               String
  appointmentsFee       Int
  current_work_place    String
  dept_id               String
  departmentId          Department                 @relation(fields: [dept_id], references: [id])
  createdAt             temporal.createdAtString()
  updatedAt             temporal.updatedAtString()
}

model Appointment {
  id               String                     @id @default(uuid())
  doct_id          String
  doctors_id       Doctors                    @relation(fields: [doct_id], references: [id])
  pati_id          String
  patients_id      Patients                   @relation(fields: [pati_id], references: [id])
  patient_name     String
  age              Int
  gender           String
  serialNumber     Int
  seeingTime       DateTime
  status           String
  appointment_date DateTime
  createdAt        temporal.createdAtString()
  updatedAt        temporal.updatedAtString()
}

model DoctorsShadule {
  id            String                     @default(uuid())
  doct_id       String
  doctors_id    Doctors                    @relation(fields: [doct_id], references: [id])
  day           Int
  bookingTime   Time()
  time_to_start Time()
  time_to_end   Time()
  capacity      Int
  createdAt     temporal.createdAtString()
  updatedAt     temporal.updatedAtString()
}
